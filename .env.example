APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Laravel Reverb (self-hosted WebSocket transport; chat payloads are end-to-end encrypted on the device)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"


# local or s3 (private bucket, AWS_* above)
OASIS_MEDIA_DISK=local

# Automated content check (Mistral, EU) via the Laravel AI SDK
MISTRAL_API_KEY=
OASIS_AI_MODERATION=true

# Where security researchers report vulnerabilities (/.well-known/security.txt); without it the contact address.
# OASIS_MAIL_SECURITY=security@example.tld

# Operations (docs/oasis-operations.md): backup key from `php artisan oasis:backup-key` (keep a copy off the server),
# backup disk (ideally a separate versioned EU bucket), restore-test database, token for /gesundheit.
OASIS_BACKUP_KEY=
OASIS_BACKUP_DISK=local
OASIS_BACKUP_VERIFY_DATABASE=oasis_restore_check
OASIS_HEALTH_TOKEN=

# Operator accounts (admin role + one of these addresses): never held or locked automatically, only they appoint admins.
OASIS_SUPER_ADMINS=info@velwebsolutions.de

# Push hints: create with php artisan oasis:push-keys (empty = push off).
OASIS_VAPID_PUBLIC=
OASIS_VAPID_PRIVATE=

# Delete accounts 30 days after trial or membership end, as AGB § 13 and the privacy policy promise (default true).
OASIS_RETENTION_AUTO_DELETE=true


# Mollie API key: test_ for development, live_ for production.
MOLLIE_KEY=
# Local only: Mollie cannot reach localhost, so run `artisan oasis:mollie-sync` after a test payment.
# MOLLIE_WEBHOOKS=false

# Proxies allowed to set X-Forwarded-* (empty = none; * only for local tunnels)
OASIS_TRUSTED_PROXIES=
